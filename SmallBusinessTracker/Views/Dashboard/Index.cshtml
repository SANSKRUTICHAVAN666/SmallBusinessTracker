@model SmallBusinessTracker.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-5">Dashboard</h1>
            <p class="text-muted">
                Overview of products, stock and sales.
            </p>
        </div>

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-primary">
            Refresh
        </a>
    </div>

    <!-- Summary Cards -->

    <div class="row">

        <div class="col-md-3 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Total Products</h6>
                    <h2>@Model.TotalProducts</h2>
                    <p class="mb-0 text-muted">
                        Products in inventory
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Available Stock</h6>
                    <h2>@Model.AvailableStock</h2>
                    <p class="mb-0 text-muted">
                        Total available quantity
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Total Sales</h6>
                    <h2>@Model.TotalSales</h2>
                    <p class="mb-0 text-muted">
                        Completed sales
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Total Revenue</h6>
                    <h2>₹@Model.TotalRevenue.ToString("N2")</h2>
                    <p class="mb-0 text-muted">
                        Overall revenue
                    </p>
                </div>
            </div>
        </div>

    </div>

    <!-- Revenue Summary -->

    <div class="row">

        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5>Today's Revenue</h5>

                    <h2 class="mt-3">
                        ₹@Model.TodayRevenue.ToString("N2")
                    </h2>

                    <p class="text-muted mb-0">
                        Revenue generated today
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5>This Month's Revenue</h5>

                    <h2 class="mt-3">
                        ₹@Model.ThisMonthRevenue.ToString("N2")
                    </h2>

                    <p class="text-muted mb-0">
                        Revenue generated this month
                    </p>
                </div>
            </div>
        </div>

    </div>

    <!-- Low Stock -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">Low Stock Products</h5>
        </div>

        <div class="card-body p-0">

            @if (Model.LowStockProducts.Count == 0)
            {
                <div class="p-4 text-center text-muted">
                    No low-stock products to display.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover mb-0">

                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Available Quantity</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var product in Model.LowStockProducts)
                            {
                                <tr>
                                    <td>@product.ProductName</td>

                                    <td>
                                        <span class="badge badge-warning">
                                            @product.Quantity
                                        </span>
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

    <!-- Daily Sales -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">Daily Sales</h5>
        </div>

        <div class="card-body p-0">

            @if (Model.DailySales.Count == 0)
            {
                <div class="p-4 text-center text-muted">
                    No daily sales data available.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover mb-0">

                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Number of Sales</th>
                                <th>Revenue</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var sale in Model.DailySales)
                            {
                                <tr>
                                    <td>@sale.Date.ToString("dd-MM-yyyy")</td>

                                    <td>
                                        @sale.NumberOfSales
                                    </td>

                                    <td>
                                        ₹@sale.Revenue.ToString("N2")
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

    <!-- Monthly Sales -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">Monthly Sales</h5>
        </div>

        <div class="card-body p-0">

            @if (Model.MonthlySales.Count == 0)
            {
                <div class="p-4 text-center text-muted">
                    No monthly sales data available.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover mb-0">

                        <thead>
                            <tr>
                                <th>Month</th>
                                <th>Number of Sales</th>
                                <th>Revenue</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var sale in Model.MonthlySales)
                            {
                                <tr>
                                    <td>@sale.Date.ToString("MMMM yyyy")</td>

                                    <td>
                                        @sale.NumberOfSales
                                    </td>

                                    <td>
                                        ₹@sale.Revenue.ToString("N2")
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>