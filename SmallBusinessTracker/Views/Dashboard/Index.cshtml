@model SmallBusinessTracker.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container">
    <div class="text-center mb-4">
        <h1 class="display-4">Business Dashboard</h1>
        <p class="text-muted">Overview of products, stock and sales</p>
    </div>

    <div class="row">

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title">Total Products</h5>
                    <h2>@Model.TotalProducts</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title">Available Stock</h5>
                    <h2>@Model.AvailableStock</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title">Total Sales</h5>
                    <h2>@Model.TotalSales</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title">Total Revenue</h5>
                    <h2>₹@Model.TotalRevenue</h2>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-body">
            <h4 class="card-title">Low Stock Products</h4>

            @if (Model.LowStockProducts.Count == 0)
            {
                <p class="text-muted">No low-stock products.</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Quantity</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var product in Model.LowStockProducts)
                        {
                            <tr>
                                <td>@product.ProductName</td>
                                <td>@product.Quantity</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>