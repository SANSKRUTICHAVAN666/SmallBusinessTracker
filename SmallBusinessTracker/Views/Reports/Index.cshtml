@model SmallBusinessTracker.Models.ReportsViewModel

@{
    ViewData["Title"] = "Reports";
}

<div class="container-fluid">

    <div class="mb-4">
        <h1 class="display-5">Reports</h1>
        <p class="text-muted">
            View sales and inventory reports.
        </p>
    </div>

    <!-- Daily Sales -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">Daily Sales Report</h5>
        </div>

        <div class="card-body p-0">

            @if (Model.DailySales.Count == 0)
            {
                <div class="p-4 text-center text-muted">
                    No daily sales data available.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover mb-0">

                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Number of Sales</th>
                                <th>Revenue</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var sale in Model.DailySales)
                            {
                                <tr>
                                    <td>
                                        @sale.Date.ToString("dd-MM-yyyy")
                                    </td>

                                    <td>
                                        @sale.NumberOfSales
                                    </td>

                                    <td>
                                        ₹@sale.Revenue.ToString("N2")
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

    <!-- Monthly Sales -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">Monthly Sales Report</h5>
        </div>

        <div class="card-body p-0">

            @if (Model.MonthlySales.Count == 0)
            {
                <div class="p-4 text-center text-muted">
                    No monthly sales data available.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover mb-0">

                        <thead>
                            <tr>
                                <th>Month</th>
                                <th>Number of Sales</th>
                                <th>Revenue</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var sale in Model.MonthlySales)
                            {
                                <tr>
                                    <td>
                                        @sale.Date.ToString("MMMM yyyy")
                                    </td>

                                    <td>
                                        @sale.NumberOfSales
                                    </td>

                                    <td>
                                        ₹@sale.Revenue.ToString("N2")
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

    <!-- Low Stock -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">Low Stock Report</h5>
        </div>

        <div class="card-body p-0">

            @if (Model.LowStockProducts.Count == 0)
            {
                <div class="p-4 text-center text-muted">
                    No low-stock products available.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover mb-0">

                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Quantity</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var product in Model.LowStockProducts)
                            {
                                <tr>
                                    <td>@product.ProductName</td>
                                    <td>@product.Quantity</td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>